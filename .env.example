# Copy this file to .env and replace every placeholder with your own values.
# Never commit the real .env file.

# Flask
SECRET_KEY=replace-with-a-long-random-secret

# SMS notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_RECIPIENT_NUMBERS=

# Email notifications. Gmail example: smtp.gmail.com / 465 / true and use a
# Google App Password (not your regular account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=Emergency Alert System <your-sender@gmail.com>

# Comma-separated responder inboxes. Emails include the reporter information,
# exact latitude/longitude, and a one-tap Google Maps location link.
POLICE_EMAIL_RECIPIENTS=police-control-room@example.com
FIRE_EMAIL_RECIPIENTS=fire-control-room@example.com
SOS_EMAIL_RECIPIENTS=medical-response@example.com
OTHER_EMAIL_RECIPIENTS=emergency-control-room@example.com
